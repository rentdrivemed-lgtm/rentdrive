# Dependencias
node_modules/
# Sin barra final, además: en un worktree/checkout donde `node_modules` es un SYMLINK
# (no un directorio real), el patrón `node_modules/` de arriba NO lo matchea y un
# `git add -A` lo commitearía como enlace simbólico.
node_modules

# Next.js
.next/
out/

# Variables de entorno (NUNCA subir)
.env.local
.env.*.local

# Base de datos local (se crea automáticamente en Railway con volumen)
rentdrive.db
rentdrive.db-shm
rentdrive.db-wal
# Copias de trabajo que hacen los scripts de prueba (scripts/probar-contratos-pdf.ts):
# son una COPIA ENTERA de la base, con datos personales. Nunca al repositorio.
rentdrive-prueba-*.db
rentdrive-prueba-*.db-shm
rentdrive-prueba-*.db-wal
# Carpeta por defecto donde esos scripts dejan los PDF y los zip generados.
/salida-contratos-pdf/

# Archivos subidos por usuarios (se persisten con volumen en Railway)
public/uploads/*
!public/uploads/.gitkeep
# Fotos de la flota demo (fixtures del seed/migración en lib/db.ts) — sí se versionan
!public/uploads/mazda3.jpg
!public/uploads/tracker.jpg
!public/uploads/picanto.jpg
!public/uploads/fortuner.jpg
!public/uploads/explorer.jpg
!public/uploads/cx5.jpg
!public/uploads/cx30.jpg
!public/uploads/duster.jpg
!public/uploads/spark.jpg
!public/uploads/corolla.jpg
!public/uploads/4runner.jpg
!public/uploads/placeholder-car.svg

# Salida del banco de pruebas del detector de placas
# (scripts/probar-deteccion-placa.ts). Son COPIAS ANOTADAS de fotos reales de
# clientes, con la placa legible — nunca deben entrar al repo.
deteccion-placa-salida/

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Documentos internos de trabajo (agentes y bitácora) — solo locales
_agentes/

# Documentos de negocio (pitch decks, modelos financieros, propuestas) —
# sensibles, nunca deben ir a un repo de código.
*.pptx
*.xlsx
*.docx

# datos locales de tarjetas NFC en modo dev (en prod usan el volumen /app/data)
/data/
